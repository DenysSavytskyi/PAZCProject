<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Language selector + light/dark toggle. Included by navbar.fxml and login.fxml. -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sk.upjs.ciphertrainer.controller.PrefsBarController"
      alignment="CENTER_RIGHT" spacing="8">
    <ComboBox fx:id="languageCombo" prefWidth="140"/>
    <Button fx:id="themeButton" styleClass="icon-button" onAction="#onToggleTheme">
        <tooltip>
            <Tooltip text="%prefs.theme"/>
        </tooltip>
    </Button>
</HBox>
