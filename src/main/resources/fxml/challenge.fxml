<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Window 5: solving a challenge (focus mode: no navbar, only Exit). Implemented by ChallengeController (Disposable). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sk.upjs.ciphertrainer.controller.ChallengeController"
            styleClass="view-root">
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label fx:id="titleLabel" styleClass="navbar-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="%challenge.time" styleClass="muted"/>
            <Label fx:id="timerLabel" text="00:00" styleClass="timer-label"/>
            <Button fx:id="exitButton" text="%challenge.exit" styleClass="danger-button" onAction="#onExit"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="16" styleClass="page">
            <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="%challenge.task" styleClass="section-title"/>
                    <Label fx:id="algorithmBadge" styleClass="badge"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="difficultyLabel" styleClass="stars-label"/>
                </HBox>
                <Label text="%challenge.instruction" styleClass="page-subtitle" wrapText="true"/>
                <TextArea fx:id="cipherArea" editable="false" wrapText="true" prefRowCount="6" styleClass="mono-area" VBox.vgrow="ALWAYS"/>
                <Label text="%challenge.yourAnswer" styleClass="field-label"/>
                <TextField fx:id="answerField" promptText="%challenge.answerPrompt" onAction="#onSubmit"/>
                <Label fx:id="feedbackLabel" wrapText="true" visible="false" managed="false"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="submitButton" text="%challenge.submit" styleClass="primary-button" onAction="#onSubmit"/>
                </HBox>
            </VBox>
            <VBox spacing="12" styleClass="card" prefWidth="300" minWidth="240" maxWidth="340">
                <Label text="%challenge.points" styleClass="section-title"/>
                <VBox spacing="2">
                    <Label text="%challenge.reward" styleClass="muted"/>
                    <Label fx:id="rewardLabel" styleClass="stat-value"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="%challenge.estimated" styleClass="muted"/>
                    <Label fx:id="estimatedLabel" styleClass="stat-accent"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="%challenge.hintCost" styleClass="muted"/>
                    <Label fx:id="hintCostLabel" text="0" styleClass="stat-value"/>
                </VBox>
                <Separator/>
                <Label text="%challenge.hints" styleClass="section-title"/>
                <VBox fx:id="hintsBox" spacing="8"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
